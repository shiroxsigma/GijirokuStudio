[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
mss = "*"
pillow = "*"
imagehash = "*"
pyaudiowpatch = "*"
sounddevice = "*"
moonshine-voice = "*"
numpy = "*"
scipy = "*"
faster-whisper = "*"

[optional]
# 高速リアルタイム日本語/英語ASR（setup_fast_asr.py でも導入可能）
sherpa-onnx = "==1.13.6"
# AI要約で summary_provider="claude" を選ぶ場合のみ必要
# （Ollama とローカル完結の利用時は不要）
anthropic = "*"
# DOCX 出力（export_docx=true）を使う場合のみ必要
python-docx = "*"
# OCR のフォールバック。Windows 内蔵 OCR が使える環境では不要
# （onnxruntime を含め約100MB）
rapidocr-onnxruntime = "*"

[dev-packages]

[requires]
python_version = "3.13"
python_full_version = "3.13.13"
