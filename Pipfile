[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
mss = "*"
pillow = "*"
imagehash = "*"
pyaudiowpatch = "*"
sounddevice = "*"
moonshine-voice = "*"
numpy = "*"
scipy = "*"
faster-whisper = "*"

[optional]
# AI要約で summary_provider="claude" を選ぶ場合のみ必要
# （Ollama とローカル完結の利用時は不要）
anthropic = "*"
# DOCX 出力（export_docx=true）を使う場合のみ必要
python-docx = "*"

[dev-packages]

[requires]
python_version = "3.13"
python_full_version = "3.13.13"
