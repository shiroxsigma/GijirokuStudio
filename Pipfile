[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
mss = "*"
pillow = "*"
imagehash = "*"
pyaudiowpatch = "*"
sounddevice = "*"
numpy = "*"
scipy = "*"
faster-whisper = "*"
pywebrtc-audio = "==0.1.0"

[local]
# 初期導入で使うローカルASR・英日翻訳。変換専用ライブラリは含めない。
sherpa-onnx = "==1.13.6"
ctranslate2 = "==4.8.2"
sentencepiece = "==0.2.2"
sacremoses = "==0.2.0"

[optional]
# 高速な日本語/英語ASR（リアルタイム・後処理共通、setup_fast_asr.py でも導入可能）
sherpa-onnx = "==1.13.6"
# AI要約で summary_provider="claude" を選ぶ場合のみ必要
# （Ollama とローカル完結の利用時は不要）
anthropic = "*"
# DOCX 出力（export_docx=true）を使う場合のみ必要
python-docx = "*"
# OCR のフォールバック。Windows 内蔵 OCR が使える環境では不要
# （onnxruntime を含め約100MB）
rapidocr-onnxruntime = "*"

[dev-packages]

[requires]
python_version = "3.13"
python_full_version = "3.13.13"
